{
  "name": "your-project-name",
  "main": "api.js",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./",        // must point to wherever index.html actually lives
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "your-db-name",
      "database_id": "your-db-id"
    }
  ]
}
